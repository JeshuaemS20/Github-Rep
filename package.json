{
  "name": "studycalc-ai",
  "private": true,
  "version": "1.0.0",
  "description": "Run scripts from repo root; the Expo app lives in ./my-app",
  "scripts": {
    "start": "npm --prefix my-app run start",
    "android": "npm --prefix my-app run android",
    "ios": "npm --prefix my-app run ios",
    "web": "npm --prefix my-app run web",
    "lint": "npm --prefix my-app run lint",
    "install:app": "npm install --prefix my-app"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2"
  },
  "dependencies": {
    "@react-navigation/native-stack": "~7.9.0",
    "react-dom": "^19.2.4",
    "react-native-web": "^0.21.2"
  }
}
